# CEMAF Environment Configuration
# Copy this file to .env and update with your values
# Environment variables follow the pattern: CEMAF_<SECTION>_<KEY>

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Environment: dev, staging, or prod
CEMAF_ENVIRONMENT=dev

# Enable debug mode (adds verbose logging)
CEMAF_DEBUG=true

# Application metadata
CEMAF_APP_NAME=cemaf
CEMAF_VERSION=0.1.0

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# LLM provider: ollama, mock, openai, openai-compatible, anthropic, bedrock, groq, together, gemini, vertex, vertex-ai, huggingface
CEMAF_LLM_PROVIDER=ollama

# Default LLM model to use
# Free/local default: gemma3:4b via Ollama. Paid/hosted models are opt-in.
CEMAF_LLM_DEFAULT_MODEL=gemma3:4b

# API key for hosted LLM providers (leave empty for Ollama/mock)
CEMAF_LLM_API_KEY=

# Custom base URL for LLM provider (optional)
CEMAF_LLM_BASE_URL=

# Default temperature for LLM calls (0.0-1.0)
CEMAF_LLM_DEFAULT_TEMPERATURE=0.7

# Maximum tokens for LLM responses (not context window)
# Note: Modern models support much larger context windows (128k-200k)
# This is the max tokens the LLM can generate in its response
# Context window is managed separately via TokenBudget (default: 8,000, max: 128,000)
CEMAF_LLM_MAX_TOKENS=4096

# Request timeout in seconds
CEMAF_LLM_TIMEOUT_SECONDS=30.0

# Maximum retry attempts
CEMAF_LLM_MAX_RETRIES=3

# =============================================================================
# PROVIDER API KEYS
# =============================================================================

# OpenAI API key (for GPT models and OpenAI embeddings)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key (for Claude models)
# Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API key (for Gemini models)
# Get at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Hugging Face API key (for Hugging Face models)
# Get at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Ollama base URL (for local models, no API key needed)
# Install from: https://ollama.ai/
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================

# Built-in embedding provider: hash, mock, openai, huggingface, sentence-transformers
CEMAF_EMBEDDING_PROVIDER=hash

# Embedding model name
# Free/offline default: hash-embedding
# OpenAI: text-embedding-3-small, text-embedding-3-large
# Sentence Transformers: all-MiniLM-L6-v2, all-mpnet-base-v2
CEMAF_EMBEDDING_MODEL=hash-embedding

# Embedding dimension (auto-detected for most providers)
CEMAF_EMBEDDING_DIMENSION=384

# =============================================================================
# VECTOR STORE CONFIGURATION
# =============================================================================

# Built-in vector store backend: memory, sqlite, pgvector
# Default: memory (for development)
CEMAF_VECTOR_STORE_BACKEND=memory

# SQLite vector store path (when CEMAF_VECTOR_STORE_BACKEND=sqlite)
CEMAF_RETRIEVAL_SQLITE_PATH=./data/retrieval.db

# =============================================================================
# MEMORY CONFIGURATION
# =============================================================================

# Memory backend: memory, json_file, sqlite, postgres, or a registered custom backend
# Default: memory (for development)
CEMAF_MEMORY_BACKEND=memory

# Default TTL for memory items (seconds)
CEMAF_MEMORY_DEFAULT_TTL_SECONDS=3600

# Maximum number of items in memory
CEMAF_MEMORY_MAX_ITEMS=10000

# JSON file memory store (if using json_file backend)
CEMAF_MEMORY_FILE_PATH=./data/cemaf_memory.json

# SQLite memory store (if using sqlite backend)
CEMAF_MEMORY_SQLITE_PATH=./data/cemaf_memory.db

# PostgreSQL DSN for postgres memory and pgvector retrieval backends
CEMAF_POSTGRES_DSN=postgresql://user:password@localhost:5432/cemaf

# Redis settings for custom registered Redis memory backends
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=cemaf:memory:

# =============================================================================
# CONTEXT SELECTION ALGORITHM
# =============================================================================

# Context selection algorithm: greedy, knapsack, optimal, or registered custom backend
# - greedy: Fast, prioritizes high-priority sources (default)
# - knapsack: Optimizes value/priority ratio within budget
# - optimal: Exhaustive search for best combination (slower)
CEMAF_CONTEXT_SELECTION_ALGORITHM=greedy

# Token estimator backend: simple, tiktoken, or registered custom backend
CEMAF_CONTEXT_TOKEN_ESTIMATOR_BACKEND=simple
CEMAF_CONTEXT_TOKEN_ESTIMATOR_MODEL=
CEMAF_CONTEXT_CHARS_PER_TOKEN=4.0

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Enable caching
CEMAF_CACHE_ENABLED=true

# Built-in cache backend: memory, ttl
CEMAF_CACHE_BACKEND=memory

# Default cache TTL (seconds)
CEMAF_CACHE_DEFAULT_TTL_SECONDS=3600

# Maximum cache size
CEMAF_CACHE_MAX_SIZE=1000

# =============================================================================
# OBSERVABILITY CONFIGURATION
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
CEMAF_OBSERVABILITY_LOG_LEVEL=INFO

# Enable distributed tracing
CEMAF_OBSERVABILITY_ENABLE_TRACING=false

# Enable metrics collection
CEMAF_OBSERVABILITY_ENABLE_METRICS=false

# Registered observability backends
# Logger backend: simple, structured, or registered custom backend
CEMAF_OBSERVABILITY_LOGGER_BACKEND=simple
# Tracer backend: noop, otel, opentelemetry, or registered custom backend
CEMAF_OBSERVABILITY_TRACER_BACKEND=noop
# Metrics backend: noop, simple, prometheus, otel, opentelemetry, or registered custom backend
CEMAF_OBSERVABILITY_METRICS_BACKEND=noop
# Run logger backend: memory, file, noop, or registered custom backend
CEMAF_OBSERVABILITY_RUN_LOGGER_BACKEND=memory
# Required when CEMAF_OBSERVABILITY_RUN_LOGGER_BACKEND=file
CEMAF_OBSERVABILITY_RUN_LOGGER_ROOT=./runs

# =============================================================================
# PERSISTENCE CONFIGURATION
# =============================================================================

# Persistence protocols ship without concrete stores. Register application
# stores first, then uncomment the matching backend selectors.
# CEMAF_PERSISTENCE_PROJECT_STORE_BACKEND=your-project-store
# CEMAF_PERSISTENCE_ARTIFACT_STORE_BACKEND=your-artifact-store
# CEMAF_PERSISTENCE_CONTENT_STORE_BACKEND=your-content-store
# CEMAF_PERSISTENCE_RUN_STORE_BACKEND=your-run-store
# DATABASE_URL=postgresql://user:password@localhost:5432/cemaf
# MONGODB_URI=mongodb://localhost:27017
# S3_ARTIFACTS_BUCKET=cemaf-artifacts
# TIMESCALE_URL=postgresql://user:password@localhost:5432/cemaf_metrics

# =============================================================================
# RESILIENCE CONFIGURATION (Retry, Circuit Breaker, Rate Limiting)
# =============================================================================

# Retry configuration
CEMAF_RESILIENCE_MAX_RETRIES=3
CEMAF_RESILIENCE_INITIAL_RETRY_DELAY_SECONDS=1.0
CEMAF_RESILIENCE_MAX_RETRY_DELAY_SECONDS=60.0
CEMAF_RESILIENCE_RETRY_BACKOFF_STRATEGY=exponential
CEMAF_RESILIENCE_RETRY_BACKOFF_MULTIPLIER=2.0
CEMAF_RESILIENCE_RETRY_JITTER=true

# Circuit breaker configuration
CEMAF_RESILIENCE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CEMAF_RESILIENCE_CIRCUIT_BREAKER_FAILURE_WINDOW_SECONDS=60.0
CEMAF_RESILIENCE_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
CEMAF_RESILIENCE_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# Rate limiter configuration
CEMAF_RESILIENCE_RATE_LIMIT_REQUESTS_PER_SECOND=10.0
CEMAF_RESILIENCE_RATE_LIMIT_BURST=10
CEMAF_RESILIENCE_RATE_LIMIT_WAIT_ON_LIMIT=true
CEMAF_RESILIENCE_RATE_LIMIT_MAX_WAIT_SECONDS=30.0

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================

CEMAF_AGENTS_MAX_ITERATIONS=10
CEMAF_AGENTS_MAX_SKILL_CALLS=50
CEMAF_AGENTS_TIMEOUT_SECONDS=300.0

# DeepAgent configuration
CEMAF_AGENTS_DEEP_AGENT_MAX_DEPTH=5
CEMAF_AGENTS_DEEP_AGENT_MAX_CHILDREN=10
CEMAF_AGENTS_DEEP_AGENT_MAX_TOTAL=100
CEMAF_AGENTS_DEEP_AGENT_TIMEOUT_SECONDS=600.0

# =============================================================================
# CATALOG CONFIGURATION
# =============================================================================

# Catalog backend: static, huggingface, or registered custom backend
CEMAF_CATALOG_BACKEND=static
CEMAF_CATALOG_ENDPOINT=
CEMAF_CATALOG_API_KEY=
CEMAF_CATALOG_TIMEOUT_SECONDS=30.0
CEMAF_CATALOG_DEFAULT_LIMIT=25

# =============================================================================
# SCHEDULER CONFIGURATION
# =============================================================================

# Scheduler backend: async, mock, or registered custom backend
CEMAF_SCHEDULER_BACKEND=async
CEMAF_SCHEDULER_MAX_CONCURRENT_JOBS=10
CEMAF_SCHEDULER_DEFAULT_JOB_TIMEOUT_SECONDS=300.0
CEMAF_SCHEDULER_DEFAULT_MAX_RETRIES=3
CEMAF_SCHEDULER_ENABLE_PERSISTENCE=false
CEMAF_SCHEDULER_CHECK_INTERVAL_SECONDS=1.0

# =============================================================================
# MCP (MODEL CONTEXT PROTOCOL) CONFIGURATION
# =============================================================================

# Transport type: stdio, sse, websocket, or registered custom backend
CEMAF_MCP_TRANSPORT_TYPE=stdio
# Generic URL for URL-backed transports. Transport-specific vars override this.
# CEMAF_MCP_TRANSPORT_URL=ws://localhost:8765/mcp
# CEMAF_MCP_SSE_BASE_URL=http://localhost:8080/mcp
# CEMAF_MCP_WEBSOCKET_URL=ws://localhost:8765/mcp
CEMAF_MCP_SERVER_TIMEOUT_SECONDS=30.0
CEMAF_MCP_MAX_MESSAGE_SIZE_BYTES=1048576
CEMAF_MCP_ENABLE_TOOL_BRIDGE=true
CEMAF_MCP_ENABLE_RESOURCE_BRIDGE=true
CEMAF_MCP_ENABLE_PROMPT_BRIDGE=true

# =============================================================================
# MODERATION CONFIGURATION
# =============================================================================

CEMAF_MODERATION_ENABLED=true
CEMAF_MODERATION_FAIL_ON_VIOLATION=true
CEMAF_MODERATION_ENABLE_PII_DETECTION=true
CEMAF_MODERATION_ENABLE_PROFANITY_FILTER=true
CEMAF_MODERATION_ENABLE_TOXICITY_CHECK=false
CEMAF_MODERATION_TOXICITY_THRESHOLD=0.7
CEMAF_MODERATION_LLM_MODEL=gemma3:4b

# =============================================================================
# ORCHESTRATION CONFIGURATION (DAG Execution)
# =============================================================================

CEMAF_ORCHESTRATION_MAX_PARALLEL_NODES=10
CEMAF_ORCHESTRATION_MAX_DAG_DEPTH=50
CEMAF_ORCHESTRATION_DEFAULT_CHECKPOINT_INTERVAL=1
CEMAF_ORCHESTRATION_ENABLE_CYCLE_DETECTION=true
CEMAF_ORCHESTRATION_CYCLE_DETECTION_LIMIT=1000
CEMAF_ORCHESTRATION_ENABLE_LOGGING=true
CEMAF_ORCHESTRATION_ENABLE_EVENTS=true
CEMAF_ORCHESTRATION_ENABLE_MODERATION=false

# =============================================================================
# EVENTS CONFIGURATION (Event Bus, Pub/Sub)
# =============================================================================

CEMAF_EVENTS_ENABLE_EVENT_BUS=true
# Event bus backend: async, memory, redis, or registered custom backend
CEMAF_EVENTS_BACKEND=async
CEMAF_EVENTS_MAX_QUEUE_SIZE=10000
CEMAF_EVENTS_ENABLE_ASYNC_HANDLERS=true
CEMAF_EVENTS_ENABLE_BATCH_PUBLISH=true
CEMAF_EVENTS_BATCH_SIZE=100
CEMAF_EVENTS_BATCH_TIMEOUT_SECONDS=1.0
# Redis event bus options
# CEMAF_EVENTS_REDIS_URL=redis://localhost:6379/2
# CEMAF_EVENTS_WORKER_ID=worker-1
CEMAF_EVENTS_REDIS_MAX_STREAM_LENGTH=100000

# =============================================================================
# STREAMING CONFIGURATION
# =============================================================================

CEMAF_STREAMING_BUFFER_SIZE=1000
CEMAF_STREAMING_ENABLE_PROGRESS_CALLBACKS=true
CEMAF_STREAMING_CHUNK_TIMEOUT_SECONDS=30.0
CEMAF_STREAMING_ENABLE_CANCELLATION=true

# =============================================================================
# VALIDATION CONFIGURATION
# =============================================================================

CEMAF_VALIDATION_STRICT_MODE=false
CEMAF_VALIDATION_FAIL_FAST=false
CEMAF_VALIDATION_ENABLE_WARNINGS=true
CEMAF_VALIDATION_ENABLE_SUGGESTIONS=true

# =============================================================================
# BLUEPRINT CONFIGURATION
# =============================================================================

CEMAF_BLUEPRINT_STRICT_VALIDATION=false
CEMAF_BLUEPRINT_REQUIRE_ALL_FIELDS=false
CEMAF_BLUEPRINT_ENABLE_CONTENT_QUALITY_CHECK=true
CEMAF_BLUEPRINT_MIN_SCENE_GOAL_LENGTH=10

# Blueprint source backend: json_file, sqlite, memory, or a registered custom backend
CEMAF_BLUEPRINT_SOURCE_BACKEND=json_file
CEMAF_BLUEPRINT_SOURCE_PATH=./data/blueprints.json
CEMAF_BLUEPRINT_SOURCE_NAME=local-blueprints
CEMAF_BLUEPRINT_SQLITE_PATH=./data/blueprints.db

# =============================================================================
# CITATION CONFIGURATION
# =============================================================================

CEMAF_CITATION_ENABLE_TRACKING=true
CEMAF_CITATION_REQUIRE_CITATIONS=false
CEMAF_CITATION_CITATION_FORMAT=apa
CEMAF_CITATION_ENABLE_VALIDATION=true

# =============================================================================
# TOOLS/SKILLS CONFIGURATION
# =============================================================================

CEMAF_TOOLS_ENABLE_CALL_RECORDING=true
CEMAF_TOOLS_MAX_TOOL_TIMEOUT_SECONDS=60.0
CEMAF_TOOLS_ENABLE_MODERATION=false
CEMAF_TOOLS_ENABLE_CACHING=true

# =============================================================================
# GENERATION CONFIGURATION (Media, Code, UI)
# =============================================================================

# Built-in generation providers: mock. Register custom backends for real services.
CEMAF_GENERATION_IMAGE_PROVIDER=mock
CEMAF_GENERATION_AUDIO_PROVIDER=mock
CEMAF_GENERATION_VIDEO_PROVIDER=mock
CEMAF_GENERATION_CODE_PROVIDER=mock
CEMAF_GENERATION_DIAGRAM_PROVIDER=mock
CEMAF_GENERATION_UI_PROVIDER=mock

# Image generation defaults
CEMAF_GENERATION_DEFAULT_IMAGE_WIDTH=1024
CEMAF_GENERATION_DEFAULT_IMAGE_HEIGHT=1024
CEMAF_GENERATION_DEFAULT_IMAGE_FORMAT=png

# Audio generation defaults
CEMAF_GENERATION_DEFAULT_AUDIO_FORMAT=mp3
CEMAF_GENERATION_DEFAULT_SAMPLE_RATE=44100

# Video generation defaults
CEMAF_GENERATION_DEFAULT_VIDEO_WIDTH=1920
CEMAF_GENERATION_DEFAULT_VIDEO_HEIGHT=1080
CEMAF_GENERATION_DEFAULT_VIDEO_FPS=24
CEMAF_GENERATION_DEFAULT_VIDEO_FORMAT=mp4

# Code generation defaults
CEMAF_GENERATION_DEFAULT_CODE_LANGUAGE=python
CEMAF_GENERATION_INCLUDE_TESTS=false
CEMAF_GENERATION_INCLUDE_DOCS=true

# =============================================================================
# EVALS CONFIGURATION (Evaluation)
# =============================================================================

CEMAF_EVALS_PASS_THRESHOLD=0.5
CEMAF_EVALS_FAIL_FAST=false
CEMAF_EVALS_INCLUDE_REASONING=true
CEMAF_EVALS_LLM_MODEL=gemma3:4b
CEMAF_EVALS_MAX_TOKENS=1000
CEMAF_EVALS_TEMPERATURE=0.0
CEMAF_EVALS_ENABLE_SEMANTIC_SIMILARITY=true
CEMAF_EVALS_SIMILARITY_THRESHOLD=0.8

# =============================================================================
# CUSTOM SETTINGS
# =============================================================================

# Add any custom settings here following the same pattern
# CEMAF_CUSTOM_MY_SETTING=value

# Example: Custom tool configuration
# CEMAF_CUSTOM_MY_TOOL_API_KEY=your_key_here
# CEMAF_CUSTOM_MY_TOOL_ENABLED=true

# Example: Custom algorithm parameters
# CEMAF_CUSTOM_ALGORITHM_PARAM1=value1
# CEMAF_CUSTOM_ALGORITHM_PARAM2=value2
